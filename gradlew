#!/bin/sh
# Gradle wrapper launcher placeholder. The standard gradle-wrapper.jar can be generated by Android Studio/Gradle Wrapper.
APP_HOME=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if [ -f "$APP_HOME/gradle/wrapper/gradle-wrapper.jar" ]; then
  exec java -classpath "$APP_HOME/gradle/wrapper/gradle-wrapper.jar" org.gradle.wrapper.GradleWrapperMain "$@"
fi
echo "gradle-wrapper.jar is not included in this generated workspace. Open the project in Android Studio and let it configure the Gradle wrapper, or install Gradle 8.7 and run it from the project root." >&2
exit 1
